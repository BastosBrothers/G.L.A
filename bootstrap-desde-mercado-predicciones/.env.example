# Proveedor: ollama (local, fase actual) | api (vLLM u OpenAI-compatible)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Gla-2 es qwen2.5-coder:1.5b, no R1. R1 queda como pesado y no se entrena.
# ollama create gla-2 -f Modelfile
OLLAMA_MODEL=gla-2
# R1 en CPU: sin pensamiento interno y tope de tokens. Sube NUM_PREDICT si corta el código.
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# --- vLLM local (fase posterior, mismo cliente OpenAI) ---
# LLM_PROVIDER=vllm
# API_BASE_URL=http://127.0.0.1:8000/v1
# API_KEY=local
# API_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
